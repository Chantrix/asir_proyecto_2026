# ------debes tener tu dominio de duckdns apuntando a tu servidor
MI_DOMINIO=<tu subdominio>.duckdns.org
DUCKDNS_TOKEN=<tu token de duckdns>

#-------variables de OPENLDAP-----
CLAVE_ADMIN_LDAP=crea tu propia contraseña
LDAP_CONFIG_PASS=crea tu contraseña para configuracion
LDAP_ORGANISATION=el nombre de tu proyecto
# --- base de datos de NEXTCLOUD ---
NC_DB_ROOT_PASS=contraseña para base de datos nextcloud (muy larga)
NC_DB_USER=usuario de base de datos de nextcloud
NC_DB_PASS=contraseña de usuario
NC_DB_NAME=nombre de la base de datos nextcloud
